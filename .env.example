# ---------------------------------------------------------------------------
# Referencia de variables. NO es un archivo que se copie tal cual: las de auth
# NO viven acá, viven en el deployment de Convex. Ver HANDOFF.md §2.
# ---------------------------------------------------------------------------

# --- Local (lo escribe `npx convex dev`, no se edita a mano) ---------------
# CONVEX_DEPLOYMENT=dev:tu-deployment
# NEXT_PUBLIC_CONVEX_URL=https://tu-deployment.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://tu-deployment.convex.site

# --- Vercel: solo estas dos ------------------------------------------------
# Deploy key de producción. Dashboard de Convex -> deployment de producción ->
# Deployment Settings -> General -> Generate Production Deploy Key, con permiso
# `deployment:deploy`. En Vercel, Environment = solo Production.
CONVEX_DEPLOY_KEY=

# Para el analizador. La ruta /api/analyze corre en Vercel, no en Convex, así
# que esta clave va acá y NO en el deployment de Convex.
ANTHROPIC_API_KEY=

# NEXT_PUBLIC_CONVEX_URL NO se pone en Vercel: la inyecta `convex deploy`
# durante el build.

# ---------------------------------------------------------------------------
# Lo de abajo NO va en Vercel ni en ningún archivo. Va en el deployment de
# Convex con `npx convex env set --prod "NOMBRE=valor"`:
#
#   JWT_PRIVATE_KEY      generada con jose (HANDOFF.md §1.2)
#   JWKS                 generada con jose
#   SITE_URL             la URL pública de Vercel
#   AUTH_GITHUB_ID       de una OAuth App distinta a la de desarrollo
#   AUTH_GITHUB_SECRET   de esa misma OAuth App
# ---------------------------------------------------------------------------
