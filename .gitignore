# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# la referencia sí se versiona: no lleva valores
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# llaves de auth generadas localmente, nunca al repo
.auth-keys.json

# Claude
.claude
.agents
