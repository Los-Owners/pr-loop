diff --git a/src/pricing/pricing.service.ts b/src/pricing/pricing.service.ts
--- a/src/pricing/pricing.service.ts
+++ b/src/pricing/pricing.service.ts
@@ -40,6 +40,22 @@ export class PricingService {
   async quote(items: CartItem[], coupon?: Coupon) {
     let total = items.reduce((acc, i) => acc + i.price * i.qty, 0)
+
+    if (items.length > 10) {
+      total = total * 0.9
+    }
+
+    if (coupon) {
+      total = await this.coupons.apply(total, coupon)
+    }
+
     return total
   }
 }

